# ─────────────────────────────────────────────────────────
# LINKEDIN SCRAPER - ENVIRONMENT CONFIGURATION
# Copy this file to .env and fill in your values
# ─────────────────────────────────────────────────────────

# LinkedIn Search Queries: supports BOTH hashtags and natural non-hashtag phrases (e.g. recruiters without tags)
LINKEDIN_SEARCH_QUERIES="#devops #hiring,#sre #hiring,#cloudengineer #hiring,#platformengineer #hiring,#kubernetes #hiring,#aws #hiring,#terraform #hiring,#devsecops #hiring,#gcp #hiring,#azure #hiring,hiring \"DevOps Engineer\" email,hiring \"Site Reliability Engineer\" email,hiring \"SRE\" email,hiring \"Cloud Engineer\" email,hiring \"Platform Engineer\" email,hiring \"Infrastructure Engineer\" email,hiring \"DevSecOps\" email,hiring \"Kubernetes\" \"send resume\",hiring \"AWS\" \"Terraform\" email,\"share your resume\" \"DevOps\",\"send your resume\" \"Cloud Engineer\""
LINKEDIN_HASHTAGS="${LINKEDIN_SEARCH_QUERIES}"

# Scrape filter: 7 = past week, 14 = past 2 weeks, 30 = past month
LINKEDIN_SCRAPE_DAYS=7

# Max posts to scrape per query
MAX_POSTS_PER_SEARCH=50

# Pause time between scrolls (seconds) - avoid detection
SCROLL_PAUSE_TIME=3

# ─── YOUR PROFILE (Used by Ollama to write emails) ───────
YOUR_NAME=Your Full Name
YOUR_ROLE=DevOps / Cloud / SRE Engineer
YOUR_SKILLS=Kubernetes, Docker, AWS, GCP, Azure, Terraform, Ansible, Jenkins, GitHub Actions, GitLab CI/CD, Linux, Python, Go, Prometheus, Grafana, Loki, Microservices, Infrastructure Automation
YOUR_EXPERIENCE=2+ years
# Only apply to jobs asking for <= this experience (e.g., 3 means 0-3 years, freshers, etc.)
MAX_TARGET_EXPERIENCE=3
# Match posts containing these domains/skills
TARGET_ROLE_KEYWORDS=devops,sre,site reliability,site reliability engineer,cloud engineer,cloud architect,platform engineer,infrastructure engineer,devsecops,kubernetes,k8s,docker,helm,argocd,argo cd,aws,gcp,google cloud,azure,terraform,iac,infrastructure as code,ansible,cloudformation,pulumi,jenkins,github actions,gitlab ci,ci/cd,cicd,prometheus,grafana,loki,datadog,elk,splunk,new relic,cloudwatch,observability,monitoring,linux,bash,shell scripting,python,golang,microservices,distributed systems,eks,gke,aks,ecs,serverless,lambda,nginx,sonarqube,trivy,incident management,disaster recovery,high availability,blue-green deployment,cloud migration,release engineer,build engineer,azure devops,aws devops,gcp devops
YOUR_MOBILE=+91-XXXXXXXXXX           # Required — shown in every email signature
YOUR_LINKEDIN=
YOUR_GITHUB=
YOUR_PORTFOLIO=                        # Optional — leave blank if none
RESUME_PATH=assets/resume.pdf

# ─── AI PROVIDER CONFIGURATION (Bedrock + Gemini Fallback) ─
# Primary provider: bedrock | gemini | ollama
AI_PROVIDER=bedrock
# Automatic fallback if primary fails or hits quota: gemini | ollama | none
AI_FALLBACK_PROVIDER=gemini

AWS_REGION=us-east-1
# Generate an Amazon Bedrock API key in AWS Console (Amazon Bedrock -> API keys)
AWS_BEARER_TOKEN_BEDROCK=
# Converse API model IDs (match region prefix: us.*, eu.*, apac.*, or base ID)
#   us.amazon.nova-lite-v1:0 | us.amazon.nova-pro-v1:0 | us.anthropic.claude-3-5-haiku-20241022-v1:0
BEDROCK_MODEL_ID=us.amazon.nova-lite-v1:0

# ─── GEMINI FALLBACK CONFIGURATION (Google AI Studio) ────
# Create an API key at: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Recommended models: gemini-2.5-flash | gemini-2.5-flash-lite | gemini-2.0-flash
GEMINI_MODEL=gemini-2.5-flash

# Optional: only used when AI_PROVIDER=ollama or AI_FALLBACK_PROVIDER=ollama
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=gemma3:12b

# ─── SMTP EMAIL CONFIGURATION ────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_EMAIL=your_email@gmail.com
# Use Gmail App Password (not your regular password)
# Generate at: https://myaccount.google.com/apppasswords
SMTP_PASSWORD=
EMAIL_SUBJECT_PREFIX=Application for

# ─── MONGODB CONFIGURATION ───────────────────────────────
MONGO_URI=mongodb://localhost:27017
MONGO_DB=linkedin_scraper

# Collection names
MONGO_POSTS_COLLECTION=scraped_posts
MONGO_EMAILS_COLLECTION=extracted_emails
MONGO_SENT_COLLECTION=sent_emails
MONGO_RESPONSES_COLLECTION=email_responses

# ─── EMAIL FILTERS & SAFETY LIMITS ───────────────────────
# Skip if already mailed this address within N days
EMAIL_COOLDOWN_DAYS=15

# Max emails to send per run (safety limit)
MAX_EMAILS_PER_DAY=30

# Delay between sending emails (seconds) - avoid spam flags
DELAY_BETWEEN_EMAILS=60

# Set to true to skip free/personal email providers (gmail.com, yahoo.com, etc.)
SKIP_PERSONAL_EMAILS=false

# ─── HEADLESS BROWSER ────────────────────────────────────
# true = run browser in background, false = visible browser
HEADLESS=false

# ─── PIPELINE MODE FLAG ──────────────────────────────────
# SCRAPE_MODE=true  → Full pipeline: scrape LinkedIn → extract → AI email → send
# SCRAPE_MODE=false → Skip scraping: use existing MongoDB email backlog → AI email → send
#                     (faster, no browser needed — great for draining saved leads)
SCRAPE_MODE=true
# DRY_RUN=true      → Preview generated emails without sending via SMTP
DRY_RUN=false

# ─── WELLFOUND AUTOMATOR ─────────────────────────────────
WELLFOUND_EMAIL=your_email@gmail.com
WELLFOUND_PASSWORD=your_password

WELLFOUND_ROLE_SLUGS=machine-learning-engineer,ai-engineer,data-scientist,python-developer,ml-engineer,generative-ai-engineer,ai-researcher,applied-scientist,llm-engineer
WELLFOUND_LOCATION=india

# WF_SCRAPE_MODE=true  → Full: scrape Wellfound → auto-apply + email → send
# WF_SCRAPE_MODE=false → Skip scrape: use 400+ saved jobs in MongoDB → auto-apply + email → send
WF_SCRAPE_MODE=true

# Whether to click Apply button natively on Wellfound
WF_AUTO_APPLY=true

# Max intro note words for native Wellfound apply modal
WF_APPLY_NOTE_MAX_WORDS=80

# Max Wellfound applies per run
WF_MAX_APPLIES_PER_DAY=40

# Don't re-apply to same job for N days
WF_APPLY_COOLDOWN_DAYS=30

# Delay between apply actions (seconds)
WF_DELAY_BETWEEN_ACTIONS=4
