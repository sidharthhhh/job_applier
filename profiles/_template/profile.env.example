# ─────────────────────────────────────────────────────────
# PROFILE TEMPLATE — Copy to profiles/<name>/profile.env
# Run with: python main.py --profile <name>
# Shared AI keys (Bedrock/Gemini) & Mongo URI come from root .env
# ─────────────────────────────────────────────────────────

# LinkedIn search queries (mix of hashtags and natural recruiter email phrases)
LINKEDIN_SEARCH_QUERIES="#role #hiring,hiring \"Target Role\" email,\"share your resume\" \"Target Role\""

# Candidate Identity & Signature
YOUR_NAME=Full Name
YOUR_ROLE=Target Role Title
YOUR_EXPERIENCE=2 years
YOUR_EDUCATION=Bachelor's Degree
YOUR_LOCATION=City, Country
YOUR_MOBILE=+91-XXXXXXXXXX
YOUR_LINKEDIN=
YOUR_GITHUB=
YOUR_PORTFOLIO=
RESUME_PATH=assets/candidate_resume.pdf

# Skills & Career Summary (used by AI and fallback templates)
YOUR_SKILLS=Skill 1, Skill 2, Skill 3, Skill 4
YOUR_VALUE_PROPOSITION=Concise 1-sentence summary of measurable achievements and domain background.

# Filtering Rules
MAX_TARGET_EXPERIENCE=3
TARGET_ROLE_KEYWORDS=keyword1,keyword2,keyword3
EXCLUDE_TITLE_KEYWORDS=director,vp,vice president,principal,head of,associate director,chief
PROFILE_ACRONYMS=KPI,ROI,CRM,SLA,SQL

# Sender Email (Use Gmail App Password for smtp.gmail.com)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_EMAIL=candidate@gmail.com
SMTP_PASSWORD=

# Isolated MongoDB database for this profile
MONGO_DB=job_applier_candidate

# Safety & Outreach Controls
EMAIL_COOLDOWN_DAYS=15
MAX_EMAILS_PER_DAY=30
DELAY_BETWEEN_EMAILS=30
SKIP_PERSONAL_EMAILS=true

